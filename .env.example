# Optional existing Awin publisher credentials; do not commit real credentials.
AWIN_PUBLISHER_ID=
AWIN_API_TOKEN=

# Optional HTTPS endpoint of the EXISTING, authorized FruitStack publisher.
# Must accept {id, channel, source_url, text, idempotency_key}
# and return a real {external_id, url} receipt.
MELONME_PUBLISH_BRIDGE_URL=
MELONME_PUBLISH_BRIDGE_TOKEN=

# Optional existing FruitStack product/offer search endpoint. One batched call.
MELONME_INVENTORY_BRIDGE_URL=
MELONME_INVENTORY_BRIDGE_TOKEN=
